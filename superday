<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>AWS SAP 문제풀기</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#f7f7f5;--surface:#ffffff;--border:#e2e2de;--border-strong:#c8c8c4;
  --text:#1a1a18;--text2:#6b6b67;--text3:#9b9b97;
  --accent:#2563eb;--accent-bg:#eff4ff;--accent-border:#bfcffe;
  --success:#16a34a;--success-bg:#f0fdf4;--success-border:#86efac;
  --danger:#dc2626;--danger-bg:#fef2f2;--danger-border:#fca5a5;
  --radius:10px;
}
@media(prefers-color-scheme:dark){
  :root{
    --bg:#1c1c1a;--surface:#2a2a28;--border:#3a3a38;--border-strong:#4a4a48;
    --text:#f0f0ee;--text2:#a0a09c;--text3:#606060;
    --accent-bg:#1e2d4a;--accent-border:#3b5bdb;
    --success-bg:#0f2a1a;--success-border:#166534;
    --danger-bg:#2a1010;--danger-border:#991b1b;
  }
}
html,body{height:100%;background:var(--bg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Arial,sans-serif;color:var(--text)}
body{display:flex;flex-direction:column;align-items:center;padding:0}
#wrap{width:100%;max-width:480px;padding:16px;display:flex;flex-direction:column;gap:14px;min-height:100svh}
.screen{display:none;flex-direction:column;gap:14px}
.screen.active{display:flex}
.hidden{display:none!important}
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px}
.badge{display:inline-block;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:600;background:var(--accent-bg);color:var(--accent);border:1px solid var(--accent-border)}
.toggle-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.toggle-label{display:flex;align-items:center;gap:7px;font-size:14px;color:var(--text2);cursor:pointer}
.toggle-label input[type=checkbox]{width:18px;height:18px;accent-color:var(--accent);cursor:pointer}
.setting-item{display:flex;align-items:center;justify-content:space-between;font-size:14px;color:var(--text2)}
.setting-input{width:80px;padding:8px;border:1px solid var(--border-strong);border-radius:6px;font-size:15px;text-align:center;background:var(--surface);color:var(--text)}
.btn{width:100%;padding:14px;border-radius:var(--radius);border:none;font-size:16px;font-weight:600;cursor:pointer;transition:opacity .15s,transform .1s;font-family:inherit}
.btn:active{transform:scale(0.98)}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:disabled{opacity:.35;cursor:not-allowed;transform:none}
.btn-secondary{background:var(--surface);color:var(--text);border:1px solid var(--border-strong)}
.btn-danger{background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border)}
.btn-row{display:flex;gap:8px}
.btn-row .btn{flex:1}
.prog-wrap{display:flex;flex-direction:column;gap:6px}
.prog-bar{height:7px;background:var(--border);border-radius:99px;overflow:hidden}
.prog-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .3s ease}
.prog-meta{display:flex;justify-content:space-between;font-size:13px;color:var(--text3)}
.q-num-badge{display:inline-block;padding:4px 8px;border-radius:6px;font-size:13px;font-weight:700;background:var(--accent-bg);color:var(--accent);margin-bottom:8px}
.q-text{font-size:18px;font-weight:600;color:var(--text);line-height:1.55}
.q-hint{font-size:13px;color:var(--text3);margin-top:7px}
.opts{display:flex;flex-direction:column;gap:9px}
.opt{display:flex;align-items:flex-start;gap:11px;padding:13px 14px;border:1.5px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--surface);transition:border-color .12s,background .12s;user-select:none}
.opt:hover{border-color:var(--border-strong)}
.opt.sel{border-color:var(--accent);background:var(--accent-bg)}
.opt.ok{border-color:var(--success-border);background:var(--success-bg)}
.opt.ng{border-color:var(--danger-border);background:var(--danger-bg)}
.opt-num{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--border-strong);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:600;color:var(--text3);margin-top:1px;transition:border-color .12s,background .12s,color .12s}
.opt.sel .opt-num{background:var(--accent);border-color:var(--accent);color:#fff}
.opt.ok .opt-num{background:var(--success);border-color:var(--success);color:#fff}
.opt.ng .opt-num{background:var(--danger);border-color:var(--danger);color:#fff}
.opt-text{font-size:16px;color:var(--text);line-height:1.5}
.opt.ok .opt-text{color:var(--success)}
.opt.ng .opt-text{color:var(--danger)}
.feedback{padding:11px 14px;border-radius:var(--radius);font-size:14px;line-height:1.5;display:none}
.feedback.ok{display:block;background:var(--success-bg);color:var(--success);border:1px solid var(--success-border)}
.feedback.ng{display:block;background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger-border)}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;text-align:center}
.stat-val{font-size:24px;font-weight:700;color:var(--text)}
.stat-val.accent{color:var(--accent)}
.stat-lbl{font-size:13px;color:var(--text3);margin-top:3px}
.missed-list{display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto}
.missed-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px}
.missed-q{font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px;line-height:1.4}
.missed-ans{font-size:13px;color:var(--success)}
.sec-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text3)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:4px 0}
.topbar-title{font-size:18px;font-weight:700;color:var(--text)}
.topbar-back{font-size:14px;color:var(--accent);cursor:pointer;padding:4px 0}
.danger-zone{margin-top:10px;padding:12px;border:1px dashed var(--danger-border);border-radius:var(--radius);background:var(--danger-bg);display:flex;flex-direction:column;gap:8px}
.danger-title{font-size:12px;font-weight:700;color:var(--danger)}
</style>
</head>
<body>
<div id="wrap">

  <div class="screen active" id="s-home">
    <div class="topbar">
      <span class="topbar-title">AWS SAP 문제풀기</span>
      <span class="badge" id="home-total-badge">707문제</span>
    </div>

    <div class="card">
      <div class="sec-label" style="margin-bottom:8px">전체 학습 진행률</div>
      <div class="prog-wrap">
        <div class="prog-bar"><div class="prog-fill" id="global-prog-fill" style="width:0%"></div></div>
        <div class="prog-meta">
          <span id="global-prog-txt">0 / 707 완료</span>
          <span id="global-prog-pct">0%</span>
        </div>
      </div>
    </div>

    <div class="card" style="display:flex; flex-direction:column; gap:12px">
      <div class="setting-item">
        <span>시작 문제 번호 (1 ~ 707)</span>
        <input type="number" id="input-start-num" class="setting-input" value="1" min="1" max="707" onchange="saveConfig()">
      </div>
      <div class="setting-item">
        <span>세션당 문제 수</span>
        <input type="number" id="input-session-size" class="setting-input" value="20" min="1" max="707" onchange="saveConfig()">
      </div>
      <div class="toggle-row">
        <label class="toggle-label"><input type="checkbox" id="chk-instant" checked onchange="saveConfig()">즉시 정오답 확인</label>
        <label class="toggle-label"><input type="checkbox" id="chk-random" onchange="saveConfig()">랜덤 출제</label>
      </div>
    </div>

    <button class="btn btn-primary hidden" id="btn-resume" onclick="resumeSession()">▶ 이어서 풀기 (<span id="resume-info"></span>)</button>
    <button class="btn btn-primary" id="btn-start-new" onclick="startNewSession()">새 세션 시작하기</button>
    <button class="btn btn-secondary hidden" id="btn-missed-start" onclick="startMissedSession()">오답만 풀기 (<span id="missed-count">0</span>문제)</button>

    <div class="danger-zone">
      <div class="danger-title">초기화 메뉴</div>
      <div class="btn-row">
        <button class="btn btn-secondary" style="font-size:13px;padding:8px" onclick="resetCurrentSession()">세션 초기화</button>
        <button class="btn btn-danger" style="font-size:13px;padding:8px" onclick="resetAllProgress()">전체 기록 초기화</button>
      </div>
    </div>
  </div>

  <div class="screen" id="s-quiz">
    <div class="topbar">
      <span class="topbar-back" onclick="showHome()">← 홈 (자동저장)</span>
      <span id="score-live" style="font-size:14px;color:var(--text3)"></span>
    </div>
    <div class="prog-wrap">
      <div class="prog-bar"><div class="prog-fill" id="prog-fill"></div></div>
      <div class="prog-meta"><span id="prog-txt"></span><span id="prog-pct"></span></div>
    </div>
    <div class="card">
      <div class="q-num-badge" id="q-num-badge"></div>
      <div class="q-text" id="q-text"></div>
      <div class="q-hint" id="q-hint"></div>
    </div>
    <div class="opts" id="opts"></div>
    <div class="feedback" id="fb"></div>
    <div class="btn-row">
      <button class="btn btn-primary" id="btn-check" onclick="checkAnswer()" disabled>확인</button>
      <button class="btn btn-primary hidden" id="btn-next" onclick="nextQ()">다음 →</button>
    </div>
  </div>

  <div class="screen" id="s-result">
    <div class="topbar"><span class="topbar-title">세션 완료</span></div>
    <div class="stat-grid">
      <div class="stat"><div class="stat-val accent" id="r-score"></div><div class="stat-lbl">세션 점수</div></div>
      <div class="stat"><div class="stat-val accent" id="r-pct"></div><div class="stat-lbl">세션 정답률</div></div>
      <div class="stat"><div class="stat-val" id="r-ok"></div><div class="stat-lbl">정답</div></div>
      <div class="stat"><div class="stat-val" id="r-ng"></div><div class="stat-lbl">오답</div></div>
    </div>
    <div id="missed-sec" class="hidden" style="flex-direction:column;gap:8px">
      <div class="sec-label">이번 세션 오답 목록</div>
      <div class="missed-list" id="missed-list"></div>
    </div>
    <div class="btn-row" style="flex-direction:column;gap:8px">
      <button class="btn btn-primary" id="btn-next-session" onclick="startNextSessionAuto()">다음 세션으로 계속 진행</button>
      <button class="btn btn-secondary" onclick="showHome()">홈으로 이동</button>
    </div>
  </div>

</div>

<script>
/* 여기에 문제 데이터 ALL_Q 기입 */

var STATS_KEY = 'aws_sap_stats_v3';
var SESSION_KEY = 'aws_sap_session_v3';
var CONFIG_KEY = 'aws_sap_config_v3';

var activeSession = null; 
var sel = new Set();
var done = false;

function loadStats(){ try { var r = localStorage.getItem(STATS_KEY); return r ? JSON.parse(r) : {}; } catch(e){ return {}; } }
function saveStats(stats){ try { localStorage.setItem(STATS_KEY, JSON.stringify(stats)); } catch(e){} }
function loadSession(){ try { var r = localStorage.getItem(SESSION_KEY); return r ? JSON.parse(r) : null; } catch(e){ return null; } }
function saveSession(session){ try { if(session) localStorage.setItem(SESSION_KEY, JSON.stringify(session)); else localStorage.removeItem(SESSION_KEY); } catch(e){} }

function loadConfig(){
  try {
    var r = localStorage.getItem(CONFIG_KEY);
    return r ? JSON.parse(r) : { startNum: 1, size: 20, instant: true, random: false };
  } catch(e){
    return { startNum: 1, size: 20, instant: true, random: false };
  }
}
function saveConfig(){
  var startNum = parseInt(document.getElementById('input-start-num').value, 10) || 1;
  var size = parseInt(document.getElementById('input-session-size').value, 10) || 20;
  var instant = document.getElementById('chk-instant').checked;
  var random = document.getElementById('chk-random').checked;
  var cfg = { startNum: startNum, size: size, instant: instant, random: random };
  try { localStorage.setItem(CONFIG_KEY, JSON.stringify(cfg)); } catch(e){}
}

function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function shuffle(a){ var b=a.slice(); for(var i=b.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=b[i];b[i]=b[j];b[j]=t;} return b; }

function show(id){
  document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

function updateGlobalStatsUI(){
  var stats = loadStats();
  var total = ALL_Q.length;
  var solvedCount = Object.keys(stats).length;
  var pct = total > 0 ? Math.round((solvedCount / total) * 100) : 0;
  
  document.getElementById('home-total-badge').textContent = total + '문제';
  document.getElementById('global-prog-fill').style.width = pct + '%';
  document.getElementById('global-prog-txt').textContent = solvedCount + ' / ' + total + ' 완료';
  document.getElementById('global-prog-pct').textContent = pct + '%';

  var missedIndices = [];
  for(var idx in stats){
    if(stats[idx] === 'ng') missedIndices.push(parseInt(idx, 10));
  }
  
  var btnMissed = document.getElementById('btn-missed-start');
  if(missedIndices.length > 0){
    btnMissed.classList.remove('hidden');
    document.getElementById('missed-count').textContent = missedIndices.length;
  } else {
    btnMissed.classList.add('hidden');
  }
}

function showHome(){
  var cfg = loadConfig();
  document.getElementById('input-start-num').value = cfg.startNum;
  document.getElementById('input-session-size').value = cfg.size;
  document.getElementById('chk-instant').checked = cfg.instant;
  document.getElementById('chk-random').checked = cfg.random;

  updateGlobalStatsUI();

  activeSession = loadSession();
  var btnResume = document.getElementById('btn-resume');
  if(activeSession && activeSession.qIndices && activeSession.cur < activeSession.qIndices.length){
    btnResume.classList.remove('hidden');
    var realQNum = activeSession.qIndices[activeSession.cur] + 1;
    document.getElementById('resume-info').textContent = '전체 ' + realQNum + '번 / 세션 ' + (activeSession.cur + 1) + '번째';
  } else {
    btnResume.classList.add('hidden');
  }

  show('s-home');
}

function startNewSession(){
  saveConfig();
  var cfg = loadConfig();
  var startIdx = Math.max(0, Math.min(ALL_Q.length - 1, cfg.startNum - 1));
  
  var pool = [];
  for(var i = startIdx; i < ALL_Q.length; i++){
    pool.push(i);
  }

  if(cfg.random){
    pool = shuffle(pool);
  }

  var count = Math.min(cfg.size, pool.length);
  var sessionIndices = pool.slice(0, count);

  activeSession = {
    mode: 'normal',
    qIndices: sessionIndices,
    cur: 0,
    okCount: 0,
    sessionMissed: []
  };

  saveSession(activeSession);
  show('s-quiz');
  renderQ();
}

function resumeSession(){
  activeSession = loadSession();
  if(!activeSession){
    alert('진행 중인 세션이 없습니다.');
    showHome();
    return;
  }
  show('s-quiz');
  renderQ();
}

function startMissedSession(){
  var stats = loadStats();
  var missedIndices = [];
  for(var idx in stats){
    if(stats[idx] === 'ng') missedIndices.push(parseInt(idx, 10));
  }
  if(missedIndices.length === 0){
    alert('틀린 문제가 없습니다!');
    return;
  }

  var cfg = loadConfig();
  if(cfg.random) missedIndices = shuffle(missedIndices);

  activeSession = {
    mode: 'missed',
    qIndices: missedIndices,
    cur: 0,
    okCount: 0,
    sessionMissed: []
  };

  saveSession(activeSession);
  show('s-quiz');
  renderQ();
}

function renderQ(){
  if(!activeSession || activeSession.cur >= activeSession.qIndices.length){
    showResult();
    return;
  }

  var qIdx = activeSession.qIndices[activeSession.cur];
  var q = ALL_Q[qIdx];
  var multi = q.answers.length > 1;
  sel = new Set();
  done = false;

  // 전체 문제 번호 및 세션 내 진행 상황 표시
  var realNum = qIdx + 1;
  document.getElementById('q-num-badge').textContent = '전체 ' + realNum + '번 문제 (세션 ' + (activeSession.cur + 1) + '/' + activeSession.qIndices.length + ')';
  document.getElementById('q-text').textContent = q.q;
  document.getElementById('q-hint').textContent = multi ? '※ 정답 ' + q.answers.length + '개 선택' : '';
  document.getElementById('score-live').textContent = '맞힌 개수: ' + activeSession.okCount;

  var pct = Math.round((activeSession.cur / activeSession.qIndices.length) * 100);
  document.getElementById('prog-fill').style.width = pct + '%';
  document.getElementById('prog-txt').textContent = activeSession.cur + ' / ' + activeSession.qIndices.length;
  document.getElementById('prog-pct').textContent = pct + '%';

  document.getElementById('fb').className = 'feedback';
  document.getElementById('fb').style.display = 'none';
  document.getElementById('btn-check').disabled = true;
  document.getElementById('btn-check').classList.remove('hidden');
  document.getElementById('btn-next').classList.add('hidden');

  var optsDiv = document.getElementById('opts');
  optsDiv.innerHTML = q.opts.map(function(optText, i){
    return '<div class="opt" onclick="toggleOpt(' + i + ')">'
      + '<div class="opt-num" id="opt-num-' + i + '">' + (i+1) + '</div>'
      + '<div class="opt-text">' + escHtml(optText) + '</div>'
      + '</div>';
  }).join('');
}

function toggleOpt(i){
  if(done) return;
  var qIdx = activeSession.qIndices[activeSession.cur];
  var q = ALL_Q[qIdx];

  if(q.answers.length === 1){
    sel.clear();
    sel.add(i);
  } else {
    if(sel.has(i)) sel.delete(i);
    else sel.add(i);
  }

  var optEls = document.querySelectorAll('.opt');
  optEls.forEach(function(el, idx){
    if(sel.has(idx)) el.classList.add('sel');
    else el.classList.remove('sel');
  });

  document.getElementById('btn-check').disabled = (sel.size !== q.answers.length);
}

function checkAnswer(){
  if(done || sel.size === 0) return;
  done = true;

  var qIdx = activeSession.qIndices[activeSession.cur];
  var q = ALL_Q[qIdx];
  
  var userAns = Array.from(sel).sort(function(a,b){return a-b;});
  var realAns = q.answers.slice().sort(function(a,b){return a-b;});
  var isOk = JSON.stringify(userAns) === JSON.stringify(realAns);

  var stats = loadStats();
  stats[qIdx] = isOk ? 'ok' : 'ng';
  saveStats(stats);

  if(isOk){
    activeSession.okCount++;
  } else {
    activeSession.sessionMissed.push(qIdx);
  }

  saveSession(activeSession);

  var optEls = document.querySelectorAll('.opt');
  optEls.forEach(function(el, idx){
    var isUserSel = sel.has(idx);
    var isRealAns = realAns.indexOf(idx) >= 0;

    if(isRealAns){
      el.classList.remove('sel');
      el.classList.add('ok');
    } else if(isUserSel){
      el.classList.remove('sel');
      el.classList.add('ng');
    }
  });

  var fb = document.getElementById('fb');
  if(isOk){
    fb.className = 'feedback ok';
    fb.textContent = '✓ 정답입니다!';
  } else {
    fb.className = 'feedback ng';
    var correctText = realAns.map(function(a){ return (a+1) + '번'; }).join(', ');
    fb.textContent = '✗ 오답입니다. 정답: ' + correctText;
  }
  fb.style.display = 'block';

  document.getElementById('btn-check').classList.add('hidden');
  document.getElementById('btn-next').classList.remove('hidden');
}

function nextQ(){
  activeSession.cur++;
  saveSession(activeSession);

  if(activeSession.cur >= activeSession.qIndices.length){
    showResult();
  } else {
    renderQ();
  }
}

function showResult(){
  show('s-result');
  var total = activeSession.qIndices.length;
  var okCount = activeSession.okCount;
  var pct = total > 0 ? Math.round((okCount / total) * 100) : 0;

  document.getElementById('r-score').textContent = okCount + ' / ' + total;
  document.getElementById('r-pct').textContent = pct + '%';
  document.getElementById('r-ok').textContent = okCount;
  document.getElementById('r-ng').textContent = total - okCount;

  var ms = document.getElementById('missed-sec');
  var ml = document.getElementById('missed-list');
  
  if(activeSession.sessionMissed.length > 0){
    ms.classList.remove('hidden');
    ms.style.display = 'flex';
    ml.innerHTML = activeSession.sessionMissed.map(function(qIdx){
      var q = ALL_Q[qIdx];
      return '<div class="missed-item">'
        + '<div class="missed-q">[전체 ' + (qIdx + 1) + '번] ' + escHtml(q.q) + '</div>'
        + '<div class="missed-ans">정답: ' + q.answers.map(function(a){ return (a+1) + '번 — ' + escHtml(q.opts[a]); }).join(' / ') + '</div>'
        + '</div>';
    }).join('');
  } else {
    ms.classList.add('hidden');
  }

  // 다음 세션을 위해 시작 번호 자동 업데이트 (현재 세션 마지막 번호 다음으로)
  var lastQIdx = activeSession.qIndices[activeSession.qIndices.length - 1];
  if(lastQIdx + 2 <= ALL_Q.length){
    document.getElementById('input-start-num').value = lastQIdx + 2;
    saveConfig();
  }

  saveSession(null);
}

function startNextSessionAuto(){
  startNewSession();
}

function resetCurrentSession(){
  if(confirm('현재 진행 중인 세션을 초기화하시겠습니까?')){
    saveSession(null);
    activeSession = null;
    showHome();
  }
}

function resetAllProgress(){
  if(confirm('경고: 전체 문제 풀이 기록과 오답 노트가 모두 삭제됩니다. 정말 초기화하시겠습니까?')){
    localStorage.removeItem(STATS_KEY);
    localStorage.removeItem(SESSION_KEY);
    activeSession = null;
    showHome();
  }
}

showHome();
</script>
